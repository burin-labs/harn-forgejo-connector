import { paginate_cursor, rate_limit_token_bucket } from "std/connectors/shared"
import { create_git_forge } from "harn-gitea-connector/git_forge"

const PROVIDER_ID = "forgejo"

const ENV_PREFIX = "FORGEJO"

const STATE_KEY = "harn-forgejo-connector.state"

const RATE_LIMIT_STATE_KEY = "harn-forgejo-connector.rate-limit"

const DEFAULT_API_BASE_URL = "https://codeberg.org/api/v1"

const DELIVERY_HEADERS = ["x-gitea-delivery", "x-forgejo-delivery"]

// Forgejo's default per-token quota mirrors Gitea: 60 requests/minute. Callers can override via
// `rate_limit` args (see __rate_limit_acquire) or set `rate_limit.disabled = true` to bypass.
const DEFAULT_RATE_LIMIT_CAPACITY = 60

const DEFAULT_RATE_LIMIT_REFILL_INTERVAL_MS = 1000

const MAX_RATE_LIMIT_WAIT_SECONDS = 60

const MAX_PAGINATION_PAGES = 50

const OUTBOUND_METHODS = [
  "api.request",
  "pull_requests.list",
  "pull_requests.comment",
  "pull_requests.update",
  "issues.list",
  "issues.comment",
  "commit_status.set",
  "repository_file.get",
]

const engine = create_git_forge(
  {
    provider_id: PROVIDER_ID,
    state_key: STATE_KEY,
    rate_limit_state_key: RATE_LIMIT_STATE_KEY,
    api_base_url: DEFAULT_API_BASE_URL,
    delivery_headers: DELIVERY_HEADERS,
    schema_name: "ForgejoEventPayload",
    revision_resource_fallback: false,
  },
)

pub fn provider_id() {
  return engine.provider_id()
}

pub fn kinds() {
  return engine.kinds()
}

pub fn payload_schema() {
  return engine.payload_schema()
}

pub fn init(harness: Harness, ctx: any = nil) {
  return engine.init(harness, ctx)
}

pub fn activate(harness: Harness, bindings: any = []) {
  return engine.activate(harness, bindings)
}

pub fn shutdown(harness: Harness) {
  return engine.shutdown(harness)
}

pub fn normalize_inbound(harness: Harness, raw: any) {
  return engine.normalize_inbound(harness, raw)
}

@complexity(allow)
/** Dispatch a supported outbound helper method. */
pub fn call(harness: Harness, method: any, args: any = {}) {
  if !contains(OUTBOUND_METHODS, method) {
    return engine.__err(
      "method_not_found",
      PROVIDER_ID + " connector does not implement outbound method `" + method + "`",
    )
  }
  if method == "api.request" {
    return __api_request(harness, args ?? {})
  }
  if method == "pull_requests.list" {
    return __paginate_list(harness, args, "/repos/" + engine.__repo_ref(args) + "/pulls")
  }
  if method == "pull_requests.comment" {
    return __comment_post(harness, args, engine.__pull_request_comment_path(args))
  }
  if method == "pull_requests.update" {
    return __api_request(
      harness,
      args
        + {
          method: "PATCH",
          path: args?.path ?? engine.__pull_request_path(args),
          body: __body_without(
            args,
            __config_keys() + ["owner", "repo", "pull_request", "pull_request_id", "path"],
          ),
        },
    )
  }
  if method == "issues.list" {
    return __paginate_list(harness, args, "/repos/" + engine.__repo_ref(args) + "/issues")
  }
  if method == "issues.comment" {
    return __comment_post(harness, args, engine.__issue_comment_path(args))
  }
  if method == "commit_status.set" {
    return __api_request(
      harness,
      args
        + {
          method: "POST",
          path: args?.path ?? engine.__commit_status_path(args),
          body: __body_without(args, __config_keys() + ["owner", "repo", "sha", "path"]),
        },
    )
  }
  return __api_request(
    harness,
    args + {method: "GET", path: args?.path ?? engine.__repository_file_path(args)},
  )
}

fn __config_keys() {
  return [
    "api_base_url",
    "access_token",
    "token",
    "personal_access_token",
    "app_password",
    "secrets",
    "rate_limit",
  ]
}

fn __body_without(args: any, keys: any) {
  const body = (args ?? {}) + {}
  for key in keys {
    body.remove(key)
  }
  return body
}

fn __rate_limit_config(args: any) {
  const cfg = args?.rate_limit ?? {}
  return {
    disabled: cfg?.disabled ?? false,
    capacity: cfg?.capacity ?? DEFAULT_RATE_LIMIT_CAPACITY,
    refill_tokens: cfg?.refill_tokens ?? 1,
    refill_interval_ms: cfg?.refill_interval_ms ?? DEFAULT_RATE_LIMIT_REFILL_INTERVAL_MS,
    scope: cfg?.scope ?? "default",
  }
}

fn __rate_limit_acquire(harness: {clock: HarnessClock, runtime: HarnessRuntime}, args: any) {
  const cfg = __rate_limit_config(args)
  if cfg.disabled {
    return Ok(true)
  }
  let buckets = harness.runtime.store_get(RATE_LIMIT_STATE_KEY) ?? {}
  const result = rate_limit_token_bucket(harness.clock, buckets.get(cfg.scope), cfg, nil)
  buckets[cfg.scope] = result.state
  harness.runtime.store_set(RATE_LIMIT_STATE_KEY, buckets)
  if result.allowed {
    return Ok(true)
  }
  const wait_ms = result.retry_after_ms
  if wait_ms > MAX_RATE_LIMIT_WAIT_SECONDS * 1000 {
    return engine.__err(
      "rate_limited",
      PROVIDER_ID + " local rate limit would block for " + to_string(wait_ms / 1000) + "s",
    )
  }
  harness.clock.sleep_ms(wait_ms)
  return Ok(true)
}

fn __maybe_wait_for_provider_rate_limit(clock: HarnessClock, response: any) {
  const remaining = engine.__header(response.headers ?? {}, "x-ratelimit-remaining")
  if remaining == nil || trim(to_string(remaining)) != "0" {
    return Ok(false)
  }
  const reset = engine.__header(response.headers ?? {}, "x-ratelimit-reset")
  if reset == nil || trim(to_string(reset)) == "" {
    return Ok(true)
  }
  const parsed_reset = try {
    to_int(reset)
  }
  if is_err(parsed_reset) {
    return Ok(true)
  }
  const wait_seconds = unwrap(parsed_reset) - to_int(clock.timestamp())
  if wait_seconds > MAX_RATE_LIMIT_WAIT_SECONDS {
    return engine.__err(
      "rate_limited",
      PROVIDER_ID + " API rate limit reset is more than " + to_string(MAX_RATE_LIMIT_WAIT_SECONDS)
        + " seconds away",
    )
  }
  if wait_seconds > 0 {
    clock.sleep_ms(wait_seconds * 1000)
  }
  return Ok(true)
}

fn __is_rate_limit_response(response: any) {
  if response.status == 429 {
    return true
  }
  const remaining = engine.__header(response.headers ?? {}, "x-ratelimit-remaining")
  return remaining != nil && trim(to_string(remaining)) == "0"
}

fn __api_request(harness: Harness, args: any) {
  const response = __api_request_full(harness, args ?? {})
  if is_err(response) {
    return response
  }
  const unwrapped = unwrap(response)
  if unwrapped.body == "" {
    return unwrapped
  }
  return unwrapped.body
}

@complexity(allow)
fn __api_request_full(harness: Harness, args: any) {
  const config = engine.__outbound_config(harness.env, args ?? {})
  if is_err(config) {
    return config
  }
  const cfg = unwrap(config)
  const permit = __rate_limit_acquire({clock: harness.clock, runtime: harness.runtime}, args ?? {})
  if is_err(permit) {
    return permit
  }
  const method = uppercase(to_string(args?.method ?? "GET"))
  const path = args?.path ?? args?.url_path ?? ""
  const url_result = engine.__api_url(cfg.api_base_url, path)
  if is_err(url_result) {
    return url_result
  }
  const url = unwrap(url_result)
  let options = {headers: {Accept: "application/json"}, retry: {max: 0, backoff_ms: 0}}
  if cfg.access_token != nil && trim(to_string(cfg.access_token)) != "" {
    options.headers["Authorization"] = "Bearer " + to_string(cfg.access_token)
  }
  if args?.body != nil {
    options["body"] = json_stringify(args.body)
    options.headers["Content-Type"] = "application/json"
  }
  return __dispatch_with_rate_limit({clock: harness.clock, net: harness.net}, method, url, options)
}

@complexity(allow)
fn __dispatch_with_rate_limit(
  harness: {clock: HarnessClock, net: HarnessNet},
  method: any,
  url: any,
  options: any,
) {
  let retried = false
  while true {
    const response_result = try {
      harness.net.request(method, url, options)
    }
    if is_err(response_result) {
      return engine.__err("transport", to_string(unwrap_err(response_result)))
    }
    const response = unwrap(response_result)
    const waited = __maybe_wait_for_provider_rate_limit(harness.clock, response)
    if is_err(waited) {
      return waited
    }
    if (response.status == 429 || (response.status == 403 && unwrap(waited))) && !retried {
      retried = true
      continue
    }
    if response.status < 200 || response.status >= 300 {
      const code = if __is_rate_limit_response(response) {
        "rate_limited"
      } else if response.status == 401 || response.status == 403 {
        "unauthorized"
      } else {
        "transport"
      }
      return engine.__err(
        code,
        PROVIDER_ID + " API request failed with status " + to_string(response.status) + ": "
          + (response.body
            ?? ""),
      )
    }
    const body_text = response.body ?? ""
    if trim(body_text) == "" {
      return Ok({status: response.status, headers: response.headers ?? {}, body: ""})
    }
    const parsed = try {
      json_parse(body_text)
    }
    if is_err(parsed) {
      return engine.__err("invalid_response", PROVIDER_ID + " API returned invalid JSON")
    }
    return Ok({status: response.status, headers: response.headers ?? {}, body: unwrap(parsed)})
  }
}

@complexity(allow)
fn __paginate_list(harness: Harness, args: any, default_path: any) {
  const base_path = args?.path ?? default_path
  const max_pages = args?.max_pages ?? MAX_PAGINATION_PAGES
  const initial_url = base_path + __pagination_query(args)
  let current_page = args?.page ?? 1
  const result = paginate_cursor(
    initial_url,
    { url, cursor ->
      const target_path = cursor ?? url
      const response = __api_request_full(harness, args + {method: "GET", path: target_path})
      if is_err(response) {
        return {items: [], _next_cursor: nil, _error: unwrap_err(response)}
      }
      const unwrapped = unwrap(response)
      const body = unwrapped.body
      const items = if type_of(body) == "list" {
        body
      } else {
        body?.data ?? body?.items ?? body?.results ?? []
      }
      const next = __next_page_cursor(harness.env, unwrapped, args, base_path, current_page)
      current_page = current_page + 1
      return {items: items, _next_cursor: next}
    },
    "/_next_cursor",
    {items_path: "/items", max_pages: max_pages},
  )
  for page in result.pages {
    if page?._error != nil {
      return Err(page._error)
    }
  }
  return {
    items: result.items,
    pages: len(result.pages),
    complete: result.complete,
    next_cursor: result.next_cursor,
  }
}

// Forgejo deployments newer than 1.20 advertise pagination through `Link: rel="next"`. If the
// caller passed an explicit `limit`/`per_page`, fall back to incrementing `?page=` so older
// deployments still page through results when the body comes back full.
@complexity(allow)
fn __next_page_cursor(
  env: HarnessEnv,
  response: any,
  args: any,
  base_path: any,
  current_page: any,
) {
  const link = engine.__header(response.headers ?? {}, "link")
  if link != nil && link != "" {
    const next = __link_header_next(link)
    if next != nil {
      return __relative_path(next, __outbound_base_url(env, args))
    }
  }
  const limit = args?.limit ?? args?.per_page
  if limit == nil {
    return nil
  }
  const body = response.body
  const body_count = if type_of(body) == "list" {
    len(body)
  } else {
    len(body?.items ?? body?.data ?? body?.results ?? [])
  }
  if body_count == 0 || body_count < limit {
    return nil
  }
  return base_path + __pagination_query(args + {page: current_page + 1, limit: limit})
}

fn __outbound_base_url(env: HarnessEnv, args: any) {
  return args?.api_base_url
    ?? env.get_or(ENV_PREFIX + "_API_BASE_URL", DEFAULT_API_BASE_URL)
}

fn __link_header_next(link: any) {
  for entry in split(link, ",") {
    const trimmed = trim(entry)
    if !contains(trimmed, "rel=\"next\"") && !contains(trimmed, "rel='next'")
      && !contains(trimmed, "rel=next") {
      continue
    }
    const after_open = split(trimmed, "<")
    if len(after_open) < 2 {
      continue
    }
    const inside = split(after_open[1], ">")
    if len(inside) >= 1 && inside[0] != "" {
      return inside[0]
    }
  }
  return nil
}

fn __relative_path(url: any, base: any) {
  const base_str = trim(to_string(base ?? ""))
  if base_str != "" && starts_with(url, base_str) {
    const suffix = url[len(base_str):len(url)]
    if starts_with(suffix, "/") {
      return suffix
    }
    return "/" + suffix
  }
  return url
}

@complexity(allow)
fn __pagination_query(args: any) {
  let parts = []
  const limit = args?.limit ?? args?.per_page
  if limit != nil {
    parts = parts + ["limit=" + url_encode(to_string(limit))]
  }
  if args?.page != nil {
    parts = parts + ["page=" + url_encode(to_string(args.page))]
  }
  if args?.state != nil {
    parts = parts + ["state=" + url_encode(to_string(args.state))]
  }
  if args?.type != nil {
    parts = parts + ["type=" + url_encode(to_string(args.type))]
  }
  if args?.sort != nil {
    parts = parts + ["sort=" + url_encode(to_string(args.sort))]
  }
  if len(parts) == 0 {
    return ""
  }
  return "?" + join(parts, "&")
}

/**
 * POST a `{body}` comment to the given default path. `args.path` overrides the
 * computed path; `args.comment` is accepted as an alias for `args.body`. Shared
 * by `pull_requests.comment` and `issues.comment`, which only differ in path.
 */
fn __comment_post(harness: Harness, args: any, default_path: any) {
  return __api_request(
    harness,
    args
      + {
        method: "POST",
        path: args?.path ?? default_path,
        body: {body: args?.body ?? args?.comment},
      },
  )
}
