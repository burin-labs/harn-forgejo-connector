import { call, shutdown } from "../src/lib"

const API = "https://codeberg.org/api/v1"

@complexity(allow)
pipeline test_rate_limit_and_pagination(harness: Harness) {
  shutdown(harness)
  harness.net.egress_policy({allow: ["codeberg.org"], default: "deny"})
  __test_rate_limit_429_retry(harness)
  __test_rate_limit_remaining_zero_retry(harness)
  __test_rate_limit_reset_too_far(harness)
  __test_preemptive_token_bucket(harness)
  __test_pagination_link_header(harness)
  __test_pagination_fallback_page_param(harness)
  __test_pagination_single_page(harness)
  shutdown(harness)
}

@complexity(allow)
fn __test_preemptive_token_bucket(harness: Harness) {
  harness.testing.http_mock_clear()
  shutdown(harness)
  harness.testing.http_mock(
    "GET",
    API + "/repos/acme/widgets",
    {status: 200, body: "{\"id\":1}", headers: {}},
  )
  const bucket_args = {
    api_base_url: API,
    access_token: "token",
    path: "/repos/acme/widgets",
    rate_limit: {capacity: 1, refill_tokens: 1, refill_interval_ms: 3600000, scope: "exhaust"},
  }
  const first = call(harness, "api.request", bucket_args)
  expect_eq(first.id, 1, "first call consumes the only available token")
  // The next acquire would block for the full refill window; the connector returns rate_limited
  // instead of sleeping past the configured ceiling.
  const second = call(harness, "api.request", bucket_args)
  expect(is_err(second), "preemptive bucket throttles the second call")
  expect_eq(unwrap_err(second).code, "rate_limited", "throttle uses the rate_limited code")
  shutdown(harness)
}

@complexity(allow)
fn __test_rate_limit_429_retry(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "POST",
    API + "/repos/acme/widgets/issues/7/comments",
    {status: 429, body: "{\"message\":\"slow down\"}", headers: {"x-ratelimit-remaining": "5"}},
  )
  harness.testing.http_mock(
    "POST",
    API + "/repos/acme/widgets/issues/7/comments",
    {status: 201, body: "{\"id\":101}", headers: {"x-ratelimit-remaining": "4"}},
  )
  const result = call(
    harness,
    "issues.comment",
    {
      api_base_url: API,
      access_token: "token",
      owner: "acme",
      repo: "widgets",
      issue: 7,
      body: "hello",
      rate_limit: {disabled: true},
    },
  )
  expect_eq(result.id, 101, "429 triggers a single retry that succeeds")
}

@complexity(allow)
fn __test_rate_limit_remaining_zero_retry(harness: Harness) {
  harness.testing.http_mock_clear()
  const near_now = to_int(harness.clock.timestamp())
  harness.testing.http_mock(
    "GET",
    API + "/repos/acme/widgets",
    {
      status: 200,
      body: "{\"id\":1,\"name\":\"widgets\"}",
      headers: {"x-ratelimit-remaining": "0", "x-ratelimit-reset": to_string(near_now)},
    },
  )
  const result = call(
    harness,
    "api.request",
    {
      api_base_url: API,
      access_token: "token",
      path: "/repos/acme/widgets",
      rate_limit: {disabled: true},
    },
  )
  expect_eq(result.id, 1, "remaining=0 with elapsed reset returns the body without erroring")
}

@complexity(allow)
fn __test_rate_limit_reset_too_far(harness: Harness) {
  harness.testing.http_mock_clear()
  const far_future = to_int(harness.clock.timestamp()) + 600
  harness.testing.http_mock(
    "GET",
    API + "/repos/acme/widgets",
    {
      status: 429,
      body: "{}",
      headers: {"x-ratelimit-remaining": "0", "x-ratelimit-reset": to_string(far_future)},
    },
  )
  const result = call(
    harness,
    "api.request",
    {
      api_base_url: API,
      access_token: "token",
      path: "/repos/acme/widgets",
      rate_limit: {disabled: true},
    },
  )
  expect(
    is_err(result),
    "rate limit reset further than the configured wait window returns an error",
  )
  expect_eq(unwrap_err(result).code, "rate_limited", "error code is rate_limited")
}

@complexity(allow)
fn __test_pagination_link_header(harness: Harness) {
  harness.testing.http_mock_clear()
  const page1_path = "/repos/acme/widgets/pulls?limit=2"
  const page2_path = "/repos/acme/widgets/pulls?limit=2&page=2"
  harness.testing.http_mock(
    "GET",
    API + page1_path,
    {
      status: 200,
      body: "[{\"number\":1,\"title\":\"first\"},{\"number\":2,\"title\":\"second\"}]",
      headers: {
        link: "<" + API + page2_path + ">; rel=\"next\", <" + API + page2_path + ">; rel=\"last\"",
        "x-total-count": "3",
      },
    },
  )
  harness.testing.http_mock(
    "GET",
    API + page2_path,
    {status: 200, body: "[{\"number\":3,\"title\":\"third\"}]", headers: {"x-total-count": "3"}},
  )
  const result = call(
    harness,
    "pull_requests.list",
    {
      api_base_url: API,
      access_token: "token",
      owner: "acme",
      repo: "widgets",
      limit: 2,
      rate_limit: {disabled: true},
    },
  )
  expect_eq(len(result.items), 3, "items collected across two pages")
  expect_eq(result.pages, 2, "two pages fetched")
  expect_eq(result.complete, true, "pagination ran to completion")
  expect_eq(result.items[2].title, "third", "page 2 items present")
}

@complexity(allow)
fn __test_pagination_fallback_page_param(harness: Harness) {
  harness.testing.http_mock_clear()
  const path1 = "/repos/acme/widgets/issues?limit=2&state=open"
  const path2 = "/repos/acme/widgets/issues?limit=2&page=2&state=open"
  harness.testing.http_mock(
    "GET",
    API + path1,
    {status: 200, body: "[{\"number\":1},{\"number\":2}]", headers: {}},
  )
  harness.testing.http_mock(
    "GET",
    API + path2,
    {status: 200, body: "[{\"number\":3}]", headers: {}},
  )
  const result = call(
    harness,
    "issues.list",
    {
      api_base_url: API,
      access_token: "token",
      owner: "acme",
      repo: "widgets",
      limit: 2,
      state: "open",
      rate_limit: {disabled: true},
    },
  )
  expect_eq(len(result.items), 3, "page param fallback collects items when Link is absent")
  expect_eq(result.complete, true, "pagination completes once a partial page is returned")
}

@complexity(allow)
fn __test_pagination_single_page(harness: Harness) {
  harness.testing.http_mock_clear()
  harness.testing.http_mock(
    "GET",
    API + "/repos/acme/widgets/pulls?limit=10",
    {status: 200, body: "[{\"number\":1}]", headers: {}},
  )
  const result = call(
    harness,
    "pull_requests.list",
    {
      api_base_url: API,
      access_token: "token",
      owner: "acme",
      repo: "widgets",
      limit: 10,
      rate_limit: {disabled: true},
    },
  )
  expect_eq(len(result.items), 1, "single short page completes immediately")
  expect_eq(result.pages, 1, "exactly one fetch")
  expect_eq(result.complete, true, "single page is complete")
}

/**
 * Require that a smoke-test condition holds. Helper `fn`s are not test
 * pipelines, so `assert` does not belong here (HARN-LNT-025).
 */
fn expect(condition, message = "expectation failed") {
  require condition, message
}

/** Require that two smoke-test values are equal, reporting both on failure. */
fn expect_eq(actual, expected, message = "values differ") {
  require actual == expected,
    message + ": expected " + to_string(expected) + ", got "
    + to_string(actual)
}
